# Copy to .env and edit before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# ---- Database ----
# Neon (or any hosted Postgres). Two things this URL must have or the backend
# will not start:
#   * the +psycopg driver - a bare postgresql:// makes SQLAlchemy reach for
#     psycopg2, which is not installed; this project runs psycopg 3
#   * ?sslmode=require - Neon refuses a plaintext connection
# Take the *pooled* host from the Neon dashboard (the one with -pooler in it),
# so the container does not hold a direct connection open per worker.
DATABASE_URL=postgresql://neondb_owner:npg_4VhzJkuYs8vN@ep-wild-shape-azll3yur-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Leave DATABASE_URL unset to fall back to the `db` container below instead.

# ---- Postgres (the local `db` container; ignored when DATABASE_URL is set) ----
POSTGRES_USER=shipping
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=shipping_z

# ---- Backend ----
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
# JSON array of browser origins allowed to call the API (your frontend URL)
CORS_ORIGINS=["http://localhost:3000"]
# Deployed, this must list the exact frontend origin, no trailing slash, e.g.
# CORS_ORIGINS=["https://your-app.vercel.app"]

# One-shot: drops every table and recreates them from the models, then re-seeds.
# Only while the data is throwaway. UNSET IT after the deploy that uses it.
# REBUILD_SCHEMA=true
# Initial admin, created on first boot (idempotent)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
# true = also seed ceo/shipping/merchant demo users (local/testing only)
SEED_DEMO_USERS=true

# ---- Frontend ----
# The URL the BROWSER uses to reach the backend. Baked in at build time,
# so rebuild the frontend image if you change it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Host port mappings ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
